# Створюємо глобальні лічильники або передаємо їх через функції
# Для простоти використання у протоколі використаємо окремі функції
# що повертають лише лічильники.

def partition(a, l, r):
    # Припускаємо, що pivot - це перший елемент (a[l])
    pivot = a[l]
    i = l - 1
    j = r + 1
    
    comparisons = 0
    assignments = 1 # 1 присвоювання для pivot = a[l]

    while True:
        i += 1
        while a[i] < pivot:
            comparisons += 1
            i += 1
        comparisons += 1 # Порівняння, яке зупинило цикл

        j -= 1
        while a[j] > pivot:
            comparisons += 1
            j -= 1
        comparisons += 1 # Порівняння, яке зупинило цикл

        if i >= j:
            return j, comparisons, assignments

        # Обмін
        a[i], a[j] = a[j], a[i]
        assignments += 3 # Три присвоювання для обміну (temp = a[i], a[i] = a[j], a[j] = temp)

def quicksort(a, l, r, total_comps_ref, total_assigns_ref):
    if l < r:
        q, c_part, a_part = partition(a, l, r)
        
        total_comps_ref[0] += c_part
        total_assigns_ref[0] += a_part
        
        quicksort(a, l, q, total_comps_ref, total_assigns_ref)
        quicksort(a, q + 1, r, total_comps_ref, total_assigns_ref)

data = [90, 10, 15, 80, 100, 6, 57, 5, 29]
comps = [0] # Використовуємо список як mutable reference для підрахунку
assigns = [0]
quicksort(data, 0, len(data)-1, comps, assigns)

print("Відсортований список (Швидке):", data)
print("Порівнянь:", comps[0], "Присвоювань:", assigns[0])
