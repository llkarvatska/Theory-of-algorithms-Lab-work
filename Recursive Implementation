def merge(left, right):
    result = []
    i = j = 0
    comparisons = 0
    assignments = 0

    while i < len(left) and j < len(right):
        comparisons += 1
        if left[i] < right[j]:
            result.append(left[i])
            assignments += 1
            i += 1
        else:
            result.append(right[j])
            assignments += 1
            j += 1
            
    # Додавання залишку
    for val in left[i:]:
        result.append(val)
        assignments += 1
    
    for val in right[j:]:
        result.append(val)
        assignments += 1
    
    return result, comparisons, assignments

def merge_sort_recursive(arr):
    if len(arr) <= 1:
        return arr, 0, 0 # Масив, Порівнянь, Присвоювань

    mid = len(arr) // 2
    
    # Рекурсивні виклики
    left, c_l, a_l = merge_sort_recursive(arr[:mid])
    right, c_r, a_r = merge_sort_recursive(arr[mid:])
    
    # Злиття
    merged_arr, c_m, a_m = merge(left, right)
    
    total_comps = c_l + c_r + c_m
    total_assigns = a_l + a_r + a_m
    
    return merged_arr, total_comps, total_assigns

data = [90, 10, 15, 80, 100, 6, 57, 5, 29]
sorted_data, comps, assigns = merge_sort_recursive(data.copy())
print("Відсортований список (Рекурсивна):", sorted_data)
print("Порівнянь:", comps, "Присвоювань:", assigns)
